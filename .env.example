# StackPipeline environment variables
#
# Copy to `.env` for local development. In production, set these in the Cloudflare
# dashboard (Workers & Pages -> stack-pipeline -> Settings -> Environment variables).
# Never commit real values.
#
# Every variable is OPTIONAL. The site builds and passes its audit with all of them
# unset: ad slots render as reserved-space placeholders, analytics tags are omitted,
# and the contact form degrades to mailto links.

# ---------------------------------------------------------------------------
# Google AdSense
# ---------------------------------------------------------------------------
# Publisher ID from your AdSense account, including the "ca-" prefix.
# When empty, no AdSense script is injected and <ins> blocks are not rendered —
# which is the correct behaviour pre-approval.
PUBLIC_ADSENSE_CLIENT=

# Set to "false" to disable Auto Ads while keeping manual slots active.
PUBLIC_ADSENSE_AUTO_ADS=true

# Manual ad unit slot IDs (numeric strings from the AdSense dashboard).
PUBLIC_ADSENSE_SLOT_IN_ARTICLE_TOP=
PUBLIC_ADSENSE_SLOT_IN_ARTICLE_MID=
PUBLIC_ADSENSE_SLOT_IN_ARTICLE_FOOT=
PUBLIC_ADSENSE_SLOT_SIDEBAR=
PUBLIC_ADSENSE_SLOT_LISTING=

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Loaded with Consent Mode v2 defaults
# set to denied for EEA/UK traffic.
PUBLIC_GA4_ID=

# Plausible domain, e.g. stackpipeline.com. Leave empty to skip.
PUBLIC_PLAUSIBLE_DOMAIN=

# ---------------------------------------------------------------------------
# Contact form
# ---------------------------------------------------------------------------
# POST endpoint for the /contact/ form (Formspree, Basin, a Cloudflare Worker, etc).
# When empty, the form renders disabled with mailto fallbacks shown instead.
PUBLIC_CONTACT_ENDPOINT=

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Handled by the Cloudflare Pages Git integration — no API tokens or GitHub
# secrets are needed. Cloudflare builds with `npm run build` and publishes `dist`.
