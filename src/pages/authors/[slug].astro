---
/**
 * Author profile page.
 *
 * Gives each Person entity a real, crawlable home with sameAs links and a full
 * bibliography — the strongest authorship signal available to a publisher.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import ContentCard from '@components/ui/ContentCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { absoluteUrl } from '@lib/seo';
import { personSchema, itemListSchema, type AuthorInput } from '@lib/schema';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  return authors.map((author) => ({ params: { slug: author.data.slug }, props: { author } }));
}

interface Props {
  author: CollectionEntry<'authors'>;
}

const { author } = Astro.props;
const data = author.data;

const [integrations, reviews, alternatives] = await Promise.all([
  getCollection('integrations', ({ data: item }) => !item.draft),
  getCollection('reviews', ({ data: item }) => !item.draft),
  getCollection('alternatives', ({ data: item }) => !item.draft),
]);

/** Everything this person wrote, newest first. */
const written = [
  ...integrations.map((entry) => ({ entry, type: 'Integration', base: '/integrations' })),
  ...reviews.map((entry) => ({ entry, type: 'Review', base: '/reviews' })),
  ...alternatives.map((entry) => ({ entry, type: 'Comparison', base: '/alternatives' })),
]
  .filter((item) => item.entry.data.author.id === author.id)
  .sort(
    (a, b) =>
      (b.entry.data.updatedDate ?? b.entry.data.publishDate).getTime() -
      (a.entry.data.updatedDate ?? a.entry.data.publishDate).getTime(),
  );

/** Everything this person fact-checked. */
const reviewed = [
  ...integrations.map((entry) => ({ entry, base: '/integrations' })),
  ...reviews.map((entry) => ({ entry, base: '/reviews' })),
  ...alternatives.map((entry) => ({ entry, base: '/alternatives' })),
].filter((item) => item.entry.data.reviewedBy?.id === author.id);

const pageUrl = absoluteUrl(`/authors/${data.slug}/`);
const sameAs = Object.values(data.links).filter((link): link is string => Boolean(link));

const authorInput: AuthorInput = {
  name: data.name,
  slug: data.slug,
  role: data.role,
  bio: data.bio,
  expertise: data.expertise,
  credentials: data.credentials,
  sameAs,
};

const schema = [
  personSchema(authorInput),
  written.length > 0
    ? itemListSchema(
        written.map((item, index) => ({
          position: index + 1,
          name: item.entry.data.heading ?? item.entry.data.title,
          url: `${item.base}/${item.entry.id}/`,
        })),
        pageUrl,
        `Articles by ${data.name}`,
      )
    : undefined,
];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Authors', href: '/about/' },
  { name: data.name, href: `/authors/${data.slug}/` },
];

const initials = data.name
  .split(' ')
  .map((part) => part[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();

const SOCIAL_LABELS: Record<string, string> = {
  linkedin: 'LinkedIn',
  x: 'X / Twitter',
  github: 'GitHub',
  website: 'Personal site',
};

/**
 * Keep the topic within the 44-char budget ("… | StackPipeline" adds 16 -> 60 total).
 * Falls back to the bare name when "Name — Role" is too long to fit.
 */
const TOPIC_BUDGET = 44;
const withRole = `${data.name} — ${data.role}`;
const pageTitle = withRole.length <= TOPIC_BUDGET ? withRole : data.name;
---

<BaseLayout
  title={pageTitle}
  description={data.shortBio}
  schema={schema}
  breadcrumbs={breadcrumbs}
  pageType="ItemPage"
>
  <div class="sp-shell py-6 lg:py-10">
    <Breadcrumbs items={breadcrumbs} class="mb-6" />

    <div class="mx-auto max-w-4xl">
      {/* ---------- Profile header ---------- */}
      <header class="flex flex-col gap-6 border-b border-ink-200 pb-8 sm:flex-row">
        <span
          class="grid h-20 w-20 shrink-0 place-items-center rounded-2xl bg-ink-950 text-2xl font-bold text-emerald-400 shadow-card"
          aria-hidden="true"
        >
          {initials}
        </span>

        <div class="min-w-0 flex-1">
          <h1 class="text-3xl font-bold tracking-tight text-ink-950 sm:text-4xl">{data.name}</h1>
          <p class="mt-1.5 text-lg font-medium text-ink-600">{data.role}</p>

          <div class="mt-4 flex flex-wrap items-center gap-4">
            {
              Object.entries(data.links).map(([key, url]) =>
                url ? (
                  <a
                    href={url}
                    target="_blank"
                    rel="noopener noreferrer me"
                    class="text-sm font-medium text-emerald-700 underline decoration-emerald-300 underline-offset-4 hover:decoration-emerald-600"
                  >
                    {SOCIAL_LABELS[key] ?? key}
                  </a>
                ) : null,
              )
            }
            {
              data.email && (
                <a
                  href={`mailto:${data.email}`}
                  class="text-sm font-medium text-ink-600 underline underline-offset-4 hover:text-ink-900"
                >
                  {data.email}
                </a>
              )
            }
          </div>
        </div>
      </header>

      {/* ---------- Bio ---------- */}
      <section class="mt-8" aria-labelledby="bio-heading">
        <h2 id="bio-heading" class="text-xl font-bold text-ink-950">Background</h2>
        <p class="mt-3 text-[15px] leading-relaxed text-ink-700">{data.bio}</p>

        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          {
            data.expertise.length > 0 && (
              <div class="rounded-xl border border-ink-200 bg-white p-5 shadow-card">
                <h3 class="text-xs font-bold uppercase tracking-[0.14em] text-ink-500">
                  Areas of expertise
                </h3>
                <ul class="mt-3 space-y-1.5">
                  {data.expertise.map((item) => (
                    <li class="flex gap-2 text-sm text-ink-700">
                      <span
                        class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500"
                        aria-hidden="true"
                      />
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          {
            data.credentials.length > 0 && (
              <div class="rounded-xl border border-ink-200 bg-white p-5 shadow-card">
                <h3 class="text-xs font-bold uppercase tracking-[0.14em] text-ink-500">
                  Credentials
                </h3>
                <ul class="mt-3 space-y-1.5">
                  {data.credentials.map((item) => (
                    <li class="flex gap-2 text-sm text-ink-700">
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="mt-0.5 shrink-0 text-emerald-600"
                        aria-hidden="true"
                      >
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </section>

      {/* ---------- Articles ---------- */}
      {
        written.length > 0 && (
          <section class="mt-12" aria-labelledby="articles-heading">
            <h2 id="articles-heading" class="text-xl font-bold text-ink-950">
              Articles by {data.name.split(' ')[0]}
              <span class="ml-2 text-base font-normal text-ink-400">({written.length})</span>
            </h2>
            <div class="mt-5 grid gap-5 sm:grid-cols-2">
              {written.map((item) => (
                <ContentCard
                  href={`${item.base}/${item.entry.id}/`}
                  title={item.entry.data.heading ?? item.entry.data.title}
                  description={item.entry.data.description}
                  eyebrow={item.type}
                  date={item.entry.data.publishDate}
                  updatedDate={item.entry.data.updatedDate}
                  tags={item.entry.data.tags}
                  headingLevel="h3"
                />
              ))}
            </div>
          </section>
        )
      }

      {
        reviewed.length > 0 && (
          <section class="mt-12" aria-labelledby="reviewed-heading">
            <h2 id="reviewed-heading" class="text-xl font-bold text-ink-950">
              Fact-checked by {data.name.split(' ')[0]}
              <span class="ml-2 text-base font-normal text-ink-400">({reviewed.length})</span>
            </h2>
            <p class="mt-2 text-sm text-ink-600">
              Articles where {data.name.split(' ')[0]} independently verified pricing, claims
              and sources before publication.
            </p>
            <ul class="mt-4 space-y-2">
              {reviewed.map((item) => (
                <li>
                  <a
                    href={`${item.base}/${item.entry.id}/`}
                    class="flex items-center gap-2 rounded-lg border border-ink-200 bg-white px-4 py-3 text-sm font-medium text-ink-800 shadow-card transition hover:border-emerald-200 hover:text-emerald-700"
                  >
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="shrink-0 text-emerald-600"
                      aria-hidden="true"
                    >
                      <path d="M9 12l2 2 4-4" />
                      <circle cx="12" cy="12" r="9" />
                    </svg>
                    {item.entry.data.heading ?? item.entry.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        written.length === 0 && reviewed.length === 0 && (
          <p class="mt-10 rounded-xl border border-dashed border-ink-300 bg-ink-50 p-6 text-center text-sm text-ink-500">
            No published articles yet.
          </p>
        )
      }
    </div>
  </div>
</BaseLayout>
