---
/**
 * Public-contact status.
 *
 * A form is deliberately not rendered without a verified destination: accepting visitor
 * data without a real, monitored channel would be misleading and unsafe.
 */
import PageLayout from '@layouts/PageLayout.astro';
import { SITE } from '@config/site';
import { absoluteUrl } from '@lib/seo';
import { webPageSchema } from '@lib/schema';

const schema = [
  webPageSchema({
    url: absoluteUrl('/contact/'),
    title: `Contact ${SITE.name}`,
    description: `Current public contact status for ${SITE.name}.`,
    type: 'ContactPage',
  }),
];
---

<PageLayout
  title={`Contact ${SITE.name}`}
  heading="Contact status"
  description="A verified public contact channel has not yet been configured."
  pageType="ContactPage"
  schema={schema}
>
  <p class="lead">
    StackPipeline does not currently publish an email address, mailing address, social profile
    or contact form because none has been verified for this project.
  </p>

  <h2 id="before-contact-is-enabled">Before contact is enabled</h2>
  <p>
    Before this page accepts messages, the publisher will provide a monitored contact channel,
    identify the responsible legal entity where required, and update the Privacy Policy to
    explain how messages are handled. Until then, please do not send personal information to
    any address or account represented as StackPipeline.
  </p>

  <h2 id="corrections-and-privacy">Corrections and privacy requests</h2>
  <p>
    A corrections and privacy-request process is not yet available because there is no
    verified channel to receive or respond to requests. Display advertising and contact-form
    collection remain disabled while this is resolved.
  </p>

  <h2 id="publisher-readiness">Publisher readiness</h2>
  <p>
    This status is intentional: a real contact channel, legal identity and publisher ID are
    prerequisites for an AdSense application. See <a href="/about/">About StackPipeline</a>
    for the current publication status.
  </p>
</PageLayout>
