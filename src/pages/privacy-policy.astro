---
/**
 * Privacy-status notice.
 *
 * A full privacy policy with controller identity and a monitored contact channel must be
 * published before the site collects submissions, enables advertising, or applies to
 * AdSense. This page states only the behavior configured today.
 */
import PageLayout from '@layouts/PageLayout.astro';
import { SITE, LEGAL, ANALYTICS, ADS } from '@config/site';

const usesAds = Boolean(ADS.client);
const usesAnalytics = Boolean(ANALYTICS.ga4 || ANALYTICS.plausibleDomain);
---

<PageLayout
  title="Privacy Policy"
  description={`Current privacy and data-collection status for ${SITE.name}.`}
  effectiveDate={LEGAL.effectiveDate}
  lastUpdated={LEGAL.lastUpdated}
>
  <p class="lead">
    This page records the data practices currently configured for {SITE.name} at{' '}
    <strong>{SITE.domain}</strong>. A verified legal entity and public privacy contact are not
    yet published, so the site does not invite visitors to submit personal information.
  </p>

  <h2 id="current-status">1. Current status</h2>
  <ul>
    <li>There is no active contact form or public email channel on this site.</li>
    <li>
      {usesAnalytics
        ? 'An analytics service is configured and may receive technical usage data as described by its own privacy notice.'
        : 'No analytics service is configured by this site.'}
    </li>
    <li>
      {usesAds
        ? 'Advertising is configured. This notice must be replaced with a complete policy before ads are enabled for visitors.'
        : 'Display advertising and an AdSense publisher ID are not configured.'}
    </li>
  </ul>

  <h2 id="hosting-and-technical-data">2. Hosting and technical data</h2>
  <p>
    Like other web hosts, the Cloudflare Pages platform and network infrastructure may process
    technical request information such as IP address, browser details, timestamps and requested
    URLs to deliver and secure the site. StackPipeline does not operate a user account system or
    a site database for visitor profiles.
  </p>

  <h2 id="third-party-links">3. Links to other sites</h2>
  <p>
    Articles may link to software vendors and other third-party sites. Those destinations have
    their own privacy practices. Review their policies before providing them with personal
    information or creating an account.
  </p>

  <h2 id="before-collection">4. Before data collection or advertising</h2>
  <p>
    Before enabling a form, analytics beyond the configuration described above, or display
    advertising, StackPipeline will publish a complete privacy policy that identifies the data
    controller where required, provides a monitored contact method, lists the relevant vendors,
    explains retention and legal bases, and provides applicable privacy-rights procedures.
  </p>

  <h2 id="contact">5. Privacy contact status</h2>
  <p>
    A public privacy-request channel has not yet been configured. Please do not submit a data
    request or other personal information through an address or account represented as
    StackPipeline. This page will be updated before the site begins collecting submissions or
    applying to AdSense.
  </p>
</PageLayout>
