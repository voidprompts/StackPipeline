---
/**
 * Guides hub.
 */
import ListingLayout from '@layouts/ListingLayout.astro';
import ContentCard from '@components/ui/ContentCard.astro';
import { getCollection, getEntry } from 'astro:content';
import { itemListSchema } from '@lib/schema';
import { absoluteUrl, readingTime as estimateReadingTime } from '@lib/seo';

const entries = await getCollection('guides', ({ data }) => !data.draft);

const enriched = await Promise.all(
  entries.map(async (entry) => {
    const author = await getEntry(entry.data.author);
    return { entry, authorName: author?.data.name };
  }),
);

const sorted = enriched.sort(
  (a, b) =>
    (b.entry.data.updatedDate ?? b.entry.data.publishDate).getTime() -
    (a.entry.data.updatedDate ?? a.entry.data.publishDate).getTime(),
);

const schema = [
  itemListSchema(
    sorted.map((item, index) => ({
      position: index + 1,
      name: item.entry.data.heading ?? item.entry.data.title,
      description: item.entry.data.description,
      url: `/guides/${item.entry.id}/`,
    })),
    absoluteUrl('/guides/'),
    'Automation and data operations guides',
  ),
];
---

<ListingLayout
  title="Automation Guides"
  heading="Automation and data operations guides"
  description="Long-form explainers on the concepts behind a working automation stack — enrichment architecture, sync design, data hygiene and cost control."
  count={entries.length}
  countLabel="guides"
  schema={schema}
  breadcrumbLeaf="Guides"
>
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      sorted.map((item) => (
        <ContentCard
          href={`/guides/${item.entry.id}/`}
          title={item.entry.data.heading ?? item.entry.data.title}
          description={item.entry.data.description}
          eyebrow="Guide"
          date={item.entry.data.publishDate}
          updatedDate={item.entry.data.updatedDate}
          tags={item.entry.data.tags}
          authorName={item.authorName}
          featured={item.entry.data.featured}
          readingTime={item.entry.data.readingTime ?? estimateReadingTime(item.entry.body ?? '')}
          headingLevel="h3"
        />
      ))
    }
  </div>

  {
    entries.length === 0 && (
      <p class="rounded-xl border border-dashed border-ink-300 bg-ink-50 p-8 text-center text-ink-500">
        No guides published yet.
      </p>
    )
  }
</ListingLayout>
