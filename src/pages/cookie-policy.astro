---
import PageLayout from '@layouts/PageLayout.astro';
import { SITE, LEGAL, ADS, ANALYTICS } from '@config/site';

const usesAds = Boolean(ADS.client);
const usesAnalytics = Boolean(ANALYTICS.ga4 || ANALYTICS.plausibleDomain);
---

<PageLayout
  title="Cookie Policy"
  description={`Current cookie and similar-technology status for ${SITE.domain}.`}
  effectiveDate={LEGAL.effectiveDate}
  lastUpdated={LEGAL.lastUpdated}
>
  <p class="lead">
    This page describes the cookie-related services currently configured by {SITE.name}. It
    will be replaced with a complete policy before the site enables advertising or introduces
    any non-essential visitor-data collection.
  </p>

  <h2 id="current-configuration">1. Current configuration</h2>
  <ul>
    <li>
      {usesAnalytics
        ? 'An analytics service is configured and may use its own measurement technologies.'
        : 'No analytics service is configured by this site.'}
    </li>
    <li>
      {usesAds
        ? 'Advertising is configured. A complete advertising and consent disclosure is required before it is enabled for visitors.'
        : 'AdSense and display advertising are not configured.'}
    </li>
    <li>
      The static host and browser may use technical storage needed to deliver pages securely
      and remember browser-level preferences. StackPipeline does not provide accounts or a
      logged-in experience.
    </li>
  </ul>

  <h2 id="future-changes">2. Before this changes</h2>
  <p>
    Before setting non-essential cookies or similar technologies, StackPipeline will publish
    the relevant vendor list, purposes, retention periods, controls and consent information,
    together with a verified privacy contact. That information is not yet available, so no
    cookie preference interface is presented.
  </p>

  <h2 id="browser-controls">3. Browser controls</h2>
  <p>
    Most browsers let you view, remove or block cookies. Blocking technical storage can affect
    how websites render or function. Third-party services linked from this site may have their
    own controls and policies.
  </p>

  <h2 id="contact">4. Contact status</h2>
  <p>
    A verified privacy contact channel has not yet been published. See the{' '}
    <a href="/privacy-policy/">Privacy Policy</a> and <a href="/contact/">contact status</a>
    for the current position.
  </p>
</PageLayout>
