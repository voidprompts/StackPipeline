---
/**
 * About page — explains the publisher, the organization byline, and the site's current
 * publication status without inventing people, qualifications, or business details.
 */
import PageLayout from '@layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@config/site';
import { absoluteUrl } from '@lib/seo';
import { webPageSchema } from '@lib/schema';

const tools = await getCollection('tools');
const [integrations, reviews, alternatives, guides] = await Promise.all([
  getCollection('integrations', ({ data }) => !data.draft),
  getCollection('reviews', ({ data }) => !data.draft),
  getCollection('alternatives', ({ data }) => !data.draft),
  getCollection('guides', ({ data }) => !data.draft),
]);

const totalGuides = integrations.length + reviews.length + alternatives.length + guides.length;

const schema = [
  webPageSchema({
    url: absoluteUrl('/about/'),
    title: `About ${SITE.name}`,
    description: `How ${SITE.name} attributes its content, handles commercial relationships and publishes editorial standards.`,
    type: 'AboutPage',
  }),
];
---

<PageLayout
  title={`About ${SITE.name}`}
  heading={`About ${SITE.name}`}
  description={`${SITE.name} covers workflow automation, data enrichment and B2B SaaS integrations.`}
  pageType="AboutPage"
  schema={schema}
  prose={false}
>
  <div class="sp-prose prose prose-slate max-w-none">
    <h2 id="what-this-site-is">What this site is</h2>
    <p>
      {SITE.name} is an editorial project about the practical work of connecting and operating
      B2B software. It publishes integration tutorials, software reviews, comparisons and a
      tool directory for operations teams.
    </p>

    <h2 id="organization-byline">Organization-level attribution</h2>
    <p>
      Published articles are credited to the {SITE.name} Editorial Team, not to named
      individuals. We removed fictional contributor profiles, biographies, credentials and
      social links rather than present them as evidence of expertise.
    </p>
    <p>
      When a real contributor is ready to be credited, their byline will include only details
      that can be verified and that they have approved for publication. Until then, the
      organization byline and the publication date are the correct attribution for each page.
    </p>

    <h2 id="what-we-cover">What we cover</h2>
    <ul>
      <li><strong>Integration tutorials</strong> — connecting specific tools and designing the surrounding workflow.</li>
      <li><strong>Software reviews</strong> — structured assessments of B2B SaaS products.</li>
      <li><strong>Alternatives and comparisons</strong> — side-by-side product research for common use cases.</li>
      <li><strong>A tool directory</strong> — normalized product information for vendors we track.</li>
    </ul>
  </div>

  <dl class="not-prose my-10 grid grid-cols-2 gap-4 sm:grid-cols-3">
    {
      [
        { label: 'Pages published', value: totalGuides },
        { label: 'Tools tracked', value: tools.length },
        { label: 'Public attribution', value: 'Organization' },
      ].map((stat) => (
        <div class="rounded-xl border border-ink-200 bg-white p-5 text-center shadow-card">
          <dt class="text-xs uppercase tracking-wider text-ink-500">{stat.label}</dt>
          <dd class="mt-1.5 text-2xl font-bold text-ink-950">{stat.value}</dd>
        </div>
      ))
    }
  </dl>

  <section class="not-prose my-12 rounded-2xl border border-amber-200 bg-amber-50 p-6" aria-labelledby="publisher-status">
    <h2 id="publisher-status" class="text-xl font-bold text-ink-950">Publisher status</h2>
    <p class="mt-3 text-sm leading-relaxed text-ink-700">
      A verified legal entity, mailing address, public contact channel, social profiles and
      advertising publisher ID have not yet been established for this project. They are not
      represented on this site. Display advertising is disabled, and the site is not ready for
      an AdSense application.
    </p>
  </section>

  <div class="sp-prose prose prose-slate max-w-none">
    <h2 id="editorial-standards">Editorial standards</h2>
    <p>
      Our <a href="/editorial-policy/">Editorial Policy</a> explains the sourcing,
      corrections and attribution standards that apply to published content. Our{' '}
      <a href="/how-we-test/">testing methodology</a> describes the intended evaluation
      framework for product assessments.
    </p>

    <h2 id="commercial-relationships">Commercial relationships</h2>
    <p>
      {SITE.name} may earn affiliate commissions from qualifying links. The{' '}
      <a href="/affiliate-disclosure/">Affiliate Disclosure</a> explains how those links are
      labeled and how commercial relationships should be kept separate from editorial work.
      No display advertising is currently enabled.
    </p>

    <h2 id="contact-status">Contact status</h2>
    <p>
      A verified public contact channel has not yet been configured. The{' '}
      <a href="/contact/">contact page</a> will be updated when one is available. Until then,
      please do not send personal information through this site.
    </p>
  </div>
</PageLayout>
