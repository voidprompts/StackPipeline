---
/**
 * Individual tool profile page.
 *
 * Acts as the entity hub for a vendor: aggregates every guide, review and comparison that
 * mentions it, and emits SoftwareApplication schema. This is what gives the programmatic
 * integration pages a strong internal linking target per vendor.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import ContentCard from '@components/ui/ContentCard.astro';
import AffiliateButton from '@components/ui/AffiliateButton.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { absoluteUrl } from '@lib/seo';
import { softwareProductSchema, itemListSchema } from '@lib/schema';
import { DISCLOSURE } from '@config/site';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map((tool) => ({ params: { slug: tool.data.slug }, props: { tool } }));
}

interface Props {
  tool: CollectionEntry<'tools'>;
}

const { tool } = Astro.props;
const data = tool.data;
const evaluationNotes = data.evaluationNotes ?? [];

const [integrations, reviews, alternatives, guides] = await Promise.all([
  getCollection('integrations', ({ data: item }) => !item.draft),
  getCollection('reviews', ({ data: item }) => !item.draft),
  getCollection('alternatives', ({ data: item }) => !item.draft),
  getCollection('guides', ({ data: item }) => !item.draft),
]);

const relatedIntegrations = integrations.filter(
  (entry) => entry.data.softwareA.id === tool.id || entry.data.softwareB.id === tool.id,
);
const relatedReviews = reviews.filter((entry) => entry.data.tool.id === tool.id);
const relatedAlternatives = alternatives.filter(
  (entry) =>
    entry.data.softwareA.id === tool.id ||
    entry.data.contenders.some((contender) => contender.tool.id === tool.id),
);
const normalizeTopic = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '');
const toolTopics = new Set([normalizeTopic(data.name), normalizeTopic(data.slug)]);
const relatedGuides = guides.filter((entry) => {
  const referenced = [entry.data.softwareA?.id, entry.data.softwareB?.id]
    .filter((value): value is string => Boolean(value))
    .map(normalizeTopic);
  const tagged = entry.data.tags.map(normalizeTopic);
  return [...referenced, ...tagged].some((topic) => toolTopics.has(topic));
});

const pageUrl = absoluteUrl(`/tools/${data.slug}/`);
const affiliateUrl = data.affiliateUrl ?? data.website;

const schema = [
  softwareProductSchema({
    url: pageUrl,
    name: data.name,
    description: data.description,
    brand: data.name,
    category: data.category,
  }),
  relatedGuides.length > 0
    ? itemListSchema(
        relatedGuides.map((entry, index) => ({
          position: index + 1,
          name: entry.data.heading ?? entry.data.title,
          url: `/guides/${entry.id}/`,
        })),
        pageUrl,
        `${data.name} guides`,
      )
    : undefined,
  relatedIntegrations.length > 0
    ? itemListSchema(
        relatedIntegrations.map((entry, index) => ({
          position: index + 1,
          name: entry.data.heading ?? entry.data.title,
          url: `/integrations/${entry.id}/`,
        })),
        pageUrl,
        `${data.name} integration guides`,
      )
    : undefined,
];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Tools', href: '/tools/' },
  { name: data.name, href: `/tools/${data.slug}/` },
];

const initial = data.name.charAt(0).toUpperCase();
const totalGuides =
  relatedGuides.length +
  relatedIntegrations.length +
  relatedReviews.length +
  relatedAlternatives.length;

/**
 * Title budget: 60 chars total, minus " | StackPipeline" (16) = 44 for the topic.
 * Pick the longest suffix that still fits, so short brand names get the richer title
 * and long ones degrade gracefully instead of being truncated with an ellipsis.
 */
const TOPIC_BUDGET = 44;
const titleCandidates = [
  `${data.name} — Pricing, Integrations & Guides`,
  `${data.name} — Pricing & Integrations`,
  `${data.name} — Pricing & Guides`,
  `${data.name} Pricing & Guides`,
  `${data.name} Guides`,
  data.name,
];
const pageTitle = titleCandidates.find((candidate) => candidate.length <= TOPIC_BUDGET) ?? data.name;
---

<BaseLayout
  title={pageTitle}
  description={`${data.name}: ${data.category.toLowerCase()} profile with practical evaluation notes and related guides. Verify current pricing with the vendor.`}
  noindex={!data.indexable}
  adsEnabled={false}
  schema={schema}
  breadcrumbs={breadcrumbs}
  pageType="ItemPage"
>
  <div class="sp-shell py-6 lg:py-10">
    <Breadcrumbs items={breadcrumbs} class="mb-6" />

    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-10">
      <article class="min-w-0">
        {/* ---------- Header ---------- */}
        <header class="flex flex-wrap items-start gap-5">
          <span
            class="grid h-16 w-16 shrink-0 place-items-center rounded-2xl text-2xl font-bold text-white shadow-card"
            style={`background-color:${data.brandColor}`}
            aria-hidden="true"
          >
            {initial}
          </span>
          <div class="min-w-0 flex-1">
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-emerald-700">
              {data.category}
            </p>
            <h1 class="mt-1 text-3xl font-bold tracking-tight text-ink-950 sm:text-4xl">
              {data.name}
            </h1>
            <p class="mt-2 text-lg leading-relaxed text-ink-600">{data.tagline}</p>
          </div>
        </header>

        {/* ---------- Reference facts ---------- */}
        <dl class="mt-8 grid grid-cols-2 gap-4 rounded-2xl border border-ink-200 bg-white p-5 shadow-card">
          <div>
            <dt class="text-xs uppercase tracking-wider text-ink-400">Catalog price</dt>
            <dd class="mt-1 font-bold text-ink-950">{data.startingPrice}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wider text-ink-400">Free tier listed</dt>
            <dd class="mt-1 font-bold text-ink-950">{data.freeTier ? 'Yes' : 'No'}</dd>
          </div>
        </dl>
        <p class="mt-3 text-xs leading-relaxed text-ink-500">
          These are catalog reference values, not a live quote. Plan terms can change, and connector counts
          are not directly comparable across vendors. Confirm current details on the{' '}
          <a href={data.website} target="_blank" rel="noopener noreferrer" class="font-semibold text-emerald-800 underline underline-offset-2">
            official {data.name} site
          </a>.
        </p>

        {/* ---------- Overview ---------- */}
        <section class="mt-10" aria-labelledby="overview-heading">
          <h2 id="overview-heading" class="text-2xl font-bold text-ink-950">
            What is {data.name}?
          </h2>
          <p class="mt-3 text-[15px] leading-relaxed text-ink-700">{data.description}</p>
          {
            data.bestFor && (
              <p class="mt-4 rounded-xl border border-emerald-200 bg-emerald-50/60 p-4 text-sm text-emerald-900">
                <strong class="font-semibold">Best for:</strong> {data.bestFor}
              </p>
            )
          }
        </section>

        {
          evaluationNotes.length > 0 && (
            <section class="mt-10" aria-labelledby="evaluation-heading" data-tool-evaluation="true">
              <h2 id="evaluation-heading" class="text-2xl font-bold text-ink-950">
                What to verify before choosing {data.name}
              </h2>
              <ul class="mt-4 space-y-3">
                {evaluationNotes.map((note) => (
                  <li class="rounded-xl border border-ink-200 bg-white p-4 text-sm leading-relaxed text-ink-700">
                    {note}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          !data.indexable && (
            <aside class="mt-8 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm leading-relaxed text-amber-950" aria-label="Editorial status">
              <strong class="font-semibold">Catalog entry, not a full review:</strong> We are still developing useful, source-supported coverage for {data.name}. Check the vendor's official site for current details and use any linked editorial pages below for context.
            </aside>
          )
        }

        {/* ---------- Related content ---------- */}
        {
          relatedGuides.length > 0 && (
            <section class="mt-10" aria-labelledby="guides-heading">
              <h2 id="guides-heading" class="text-2xl font-bold text-ink-950">
                {data.name} guides and explainers
              </h2>
              <div class="mt-5 grid gap-4 sm:grid-cols-2">
                {relatedGuides.map((entry) => (
                  <ContentCard
                    href={`/guides/${entry.id}/`}
                    title={entry.data.heading ?? entry.data.title}
                    description={entry.data.description}
                    eyebrow="Guide"
                    date={entry.data.publishDate}
                    updatedDate={entry.data.updatedDate}
                    headingLevel="h3"
                  />
                ))}
              </div>
            </section>
          )
        }

        {
          relatedIntegrations.length > 0 && (
            <section class="mt-10" aria-labelledby="integrations-heading">
              <h2 id="integrations-heading" class="text-2xl font-bold text-ink-950">
                {data.name} integration guides
              </h2>
              <div class="mt-5 grid gap-4 sm:grid-cols-2">
                {relatedIntegrations.map((entry) => (
                  <ContentCard
                    href={`/integrations/${entry.id}/`}
                    title={entry.data.heading ?? entry.data.title}
                    description={entry.data.description}
                    eyebrow="Integration"
                    date={entry.data.publishDate}
                    updatedDate={entry.data.updatedDate}
                    headingLevel="h3"
                  />
                ))}
              </div>
            </section>
          )
        }

        {
          relatedReviews.length > 0 && (
            <section class="mt-10" aria-labelledby="reviews-heading">
              <h2 id="reviews-heading" class="text-2xl font-bold text-ink-950">
                Our {data.name} review
              </h2>
              <div class="mt-5 grid gap-4 sm:grid-cols-2">
                {relatedReviews.map((entry) => (
                  <ContentCard
                    href={`/reviews/${entry.id}/`}
                    title={entry.data.heading ?? entry.data.title}
                    description={entry.data.description}
                    eyebrow="Review"
                    rating={entry.data.rating.value}
                    date={entry.data.publishDate}
                    updatedDate={entry.data.updatedDate}
                    headingLevel="h3"
                  />
                ))}
              </div>
            </section>
          )
        }

        {
          relatedAlternatives.length > 0 && (
            <section class="mt-10" aria-labelledby="alternatives-heading">
              <h2 id="alternatives-heading" class="text-2xl font-bold text-ink-950">
                {data.name} comparisons
              </h2>
              <div class="mt-5 grid gap-4 sm:grid-cols-2">
                {relatedAlternatives.map((entry) => (
                  <ContentCard
                    href={`/alternatives/${entry.id}/`}
                    title={entry.data.heading ?? entry.data.title}
                    description={entry.data.description}
                    eyebrow="Comparison"
                    date={entry.data.publishDate}
                    updatedDate={entry.data.updatedDate}
                    headingLevel="h3"
                  />
                ))}
              </div>
            </section>
          )
        }

        {
          totalGuides === 0 && (
            <p class="mt-10 rounded-xl border border-dashed border-ink-300 bg-ink-50 p-6 text-center text-sm text-ink-500">
              We have not published guides covering {data.name} yet. Check back soon.
            </p>
          )
        }
      </article>

      {/* ---------- Sidebar ---------- */}
      <aside class="min-w-0">
        <div class="lg:sticky lg:top-24">
          <div class="overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-card">
            <div class="bg-ink-950 px-5 py-3">
              <h2 class="text-sm font-bold text-white">
                {data.indexable ? `About ${data.name}` : `${data.name} official site`}
              </h2>
            </div>
            <div class="p-5">
              <p class="text-sm leading-relaxed text-ink-600">{data.tagline}</p>
              <a
                href={data.website}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex w-full items-center justify-center rounded-lg border border-ink-200 px-4 py-2.5 text-sm font-semibold text-ink-800 transition hover:border-emerald-300 hover:bg-emerald-50"
              >
                Visit official website
              </a>
              {
                data.indexable && data.affiliateUrl && (
                  <>
                    <AffiliateButton
                      href={affiliateUrl}
                      product={data.name}
                      campaign={`tool-page-${data.slug}`}
                      fullWidth
                      class="mt-3"
                      size="sm"
                    />
                    <p class="mt-3 border-t border-ink-100 pt-3 text-xs leading-relaxed text-ink-400">
                      {DISCLOSURE.short}
                    </p>
                  </>
                )
              }
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
