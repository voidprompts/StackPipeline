---
/**
 * Homepage.
 *
 * Hero is text-only by design: the LCP element is an <h1>, which renders from inlined
 * CSS with no image or font fetch on the critical path. That is the cheapest possible
 * path to a sub-1s LCP, and it is why there is no hero image here.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import ContentCard from '@components/ui/ContentCard.astro';
import ToolCard from '@components/ui/ToolCard.astro';
import AdSlot from '@components/ads/AdSlot.astro';
import { getCollection, getEntry } from 'astro:content';
import { SITE } from '@config/site';
import { itemListSchema } from '@lib/schema';
import { absoluteUrl, readingTime as estimateReadingTime } from '@lib/seo';

const [integrations, reviews, alternatives, tools] = await Promise.all([
  getCollection('integrations', ({ data }) => !data.draft),
  getCollection('reviews', ({ data }) => !data.draft),
  getCollection('alternatives', ({ data }) => !data.draft),
  getCollection('tools'),
]);

/** Newest-first across all editorial collections. */
const latest = [
  ...integrations.map((entry) => ({ entry, type: 'Integration', base: '/integrations' })),
  ...reviews.map((entry) => ({ entry, type: 'Review', base: '/reviews' })),
  ...alternatives.map((entry) => ({ entry, type: 'Comparison', base: '/alternatives' })),
]
  .sort(
    (a, b) =>
      (b.entry.data.updatedDate ?? b.entry.data.publishDate).getTime() -
      (a.entry.data.updatedDate ?? a.entry.data.publishDate).getTime(),
  )
  .slice(0, 6);

const featuredTools = [...tools]
  .sort((a, b) => (b.data.rating ?? 0) - (a.data.rating ?? 0))
  .slice(0, 6);

const totalGuides = integrations.length + reviews.length + alternatives.length;

/** Resolve author names for the card bylines. */
const latestWithAuthors = await Promise.all(
  latest.map(async (item) => {
    const author = await getEntry(item.entry.data.author);
    return { ...item, authorName: author?.data.name };
  }),
);

const schema = [
  itemListSchema(
    latest.map((item, index) => ({
      position: index + 1,
      name: item.entry.data.heading ?? item.entry.data.title,
      description: item.entry.data.description,
      url: `${item.base}/${item.entry.id}/`,
    })),
    absoluteUrl('/'),
    'Latest guides from StackPipeline',
  ),
];

const SECTIONS = [
  {
    href: '/integrations/',
    title: 'Integration guides',
    description:
      'Step-by-step walkthroughs for connecting any two tools in your stack, including the failure modes vendor docs leave out.',
    count: integrations.length,
    icon: 'M4 7h7a4 4 0 0 1 4 4v2a4 4 0 0 0 4 4h1',
  },
  {
    href: '/reviews/',
    title: 'Software reviews',
    description:
      'Hands-on scorecards built from paid-plan testing, with verified pricing and match-rate data you can check yourself.',
    count: reviews.length,
    icon: 'M11.48 3.5a.56.56 0 0 1 1.04 0l2.13 4.32 4.77.7c.46.06.64.63.31.95l-3.45 3.36.81 4.75c.08.46-.4.81-.81.59L12 15.92l-4.27 2.25c-.41.22-.89-.13-.81-.59l.81-4.75-3.45-3.36a.56.56 0 0 1 .31-.95l4.77-.7z',
  },
  {
    href: '/alternatives/',
    title: 'Alternatives & comparisons',
    description:
      'Ranked breakdowns of competing tools, tested on identical workflows so the comparison actually means something.',
    count: alternatives.length,
    icon: 'M3 6h18M3 12h18M3 18h18',
  },
  {
    href: '/tools/',
    title: 'Tool directory',
    description:
      'Normalised pricing, integration counts and category data for every vendor we cover, in one sortable index.',
    count: tools.length,
    icon: 'M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z',
  },
];
---

<BaseLayout
  title={`${SITE.name} — B2B SaaS Integration Guides`}
  description={SITE.description}
  rawTitle
  schema={schema}
  canonical="/"
>
  {/* ---------- Hero ---------- */}
  <section class="relative overflow-hidden border-b border-ink-200 bg-ink-950 text-white">
    <div class="sp-grid-bg absolute inset-0" aria-hidden="true"></div>
    <div
      class="absolute -right-32 -top-32 h-96 w-96 rounded-full bg-emerald-500/10 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="sp-shell relative py-16 lg:py-24">
      <div class="max-w-3xl">
        <p
          class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 text-xs font-medium text-ink-200"
        >
          <span class="h-1.5 w-1.5 animate-pulse-dot rounded-full bg-emerald-400" aria-hidden="true"
          ></span>
          {totalGuides} guides · {tools.length} tools tracked · updated weekly
        </p>

        {/* LCP element: plain text, no webfont, no image. */}
        <h1
          class="mt-6 text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl lg:text-6xl"
        >
          Connect your stack.
          <span class="block text-emerald-400">Stop doing it by hand.</span>
        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-200 sm:text-xl">
          Practical integration tutorials, tested software reviews and honest tool
          comparisons for the people who actually maintain the automation stack.
        </p>

        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href="/integrations/"
            class="rounded-xl bg-emerald-500 px-6 py-3.5 text-base font-semibold text-ink-950 shadow-emerald-glow transition hover:bg-emerald-400"
          >
            Browse integration guides
          </a>
          <a
            href="/reviews/"
            class="rounded-xl border border-white/20 px-6 py-3.5 text-base font-semibold text-white transition hover:border-white/40 hover:bg-white/5"
          >
            Read software reviews
          </a>
        </div>

        <dl class="mt-12 grid max-w-2xl grid-cols-2 gap-6 border-t border-white/10 pt-8 sm:grid-cols-4">
          <div>
            <dt class="text-xs uppercase tracking-wider text-ink-400">Tools tested</dt>
            <dd class="mt-1 text-2xl font-bold">{tools.length}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wider text-ink-400">Hours of testing</dt>
            <dd class="mt-1 text-2xl font-bold">400+</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wider text-ink-400">Review cycle</dt>
            <dd class="mt-1 text-2xl font-bold">90 days</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wider text-ink-400">Vendor influence</dt>
            <dd class="mt-1 text-2xl font-bold text-emerald-400">Zero</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  {/* ---------- Sections ---------- */}
  <section class="sp-shell py-14 lg:py-20" aria-labelledby="sections-heading">
    <h2 id="sections-heading" class="text-2xl font-bold text-ink-950 sm:text-3xl">
      Start where your problem is
    </h2>
    <p class="mt-3 max-w-2xl text-ink-600">
      Everything on {SITE.name} is organised around the question you are actually trying to
      answer.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        SECTIONS.map((section) => (
          <a
            href={section.href}
            class="group rounded-2xl border border-ink-200 bg-white p-5 shadow-card transition-all duration-200 hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-lift"
          >
            <span
              class="grid h-10 w-10 place-items-center rounded-xl bg-ink-950 text-emerald-400 transition group-hover:bg-emerald-600 group-hover:text-white"
              aria-hidden="true"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d={section.icon} />
              </svg>
            </span>
            <h3 class="mt-4 text-base font-bold text-ink-950 group-hover:text-emerald-700">
              {section.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{section.description}</p>
            <p class="mt-3 text-xs font-semibold uppercase tracking-wider text-emerald-700">
              {section.count} {section.count === 1 ? 'entry' : 'entries'} →
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <div class="sp-shell">
    <AdSlot slot="listing" format="leaderboard" />
  </div>

  {/* ---------- Latest ---------- */}
  <section class="sp-shell py-14 lg:py-20" aria-labelledby="latest-heading">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="latest-heading" class="text-2xl font-bold text-ink-950 sm:text-3xl">
          Latest guides
        </h2>
        <p class="mt-2 text-ink-600">Freshly published and recently re-verified.</p>
      </div>
      <a
        href="/integrations/"
        class="text-sm font-semibold text-emerald-700 underline decoration-emerald-300 underline-offset-4 hover:decoration-emerald-600"
      >
        View all guides
      </a>
    </div>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        latestWithAuthors.map((item) => (
          <ContentCard
            href={`${item.base}/${item.entry.id}/`}
            title={item.entry.data.heading ?? item.entry.data.title}
            description={item.entry.data.description}
            eyebrow={item.type}
            date={item.entry.data.publishDate}
            updatedDate={item.entry.data.updatedDate}
            tags={item.entry.data.tags}
            authorName={item.authorName}
            featured={item.entry.data.featured}
            readingTime={
              item.entry.data.readingTime ?? estimateReadingTime(item.entry.body ?? '')
            }
            headingLevel="h3"
          />
        ))
      }
    </div>
  </section>

  {/* ---------- Tools ---------- */}
  <section class="border-t border-ink-200 bg-ink-50/50 py-14 lg:py-20" aria-labelledby="tools-heading">
    <div class="sp-shell">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="tools-heading" class="text-2xl font-bold text-ink-950 sm:text-3xl">
            Top-rated tools
          </h2>
          <p class="mt-2 text-ink-600">Ranked by our tested score, not by commission rate.</p>
        </div>
        <a
          href="/tools/"
          class="text-sm font-semibold text-emerald-700 underline decoration-emerald-300 underline-offset-4 hover:decoration-emerald-600"
        >
          Full directory
        </a>
      </div>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {featuredTools.map((tool) => <ToolCard tool={tool} headingLevel="h3" />)}
      </div>
    </div>
  </section>

  {/* ---------- Trust ---------- */}
  <section class="sp-shell py-14 lg:py-20" aria-labelledby="trust-heading">
    <div class="rounded-3xl border border-ink-200 bg-white p-8 shadow-card lg:p-12">
      <div class="grid gap-8 lg:grid-cols-2 lg:gap-16">
        <div>
          <h2 id="trust-heading" class="text-2xl font-bold text-ink-950 sm:text-3xl">
            How we keep this honest
          </h2>
          <p class="mt-4 leading-relaxed text-ink-600">
            {SITE.name} makes money from affiliate commissions. That creates an obvious
            incentive problem, so we built the process to remove it: scores are assigned
            before monetisation is applied, every tool is tested on a paid or trial plan,
            and pricing is re-verified against vendor pages on a fixed 90-day cycle.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="/how-we-test/"
              class="rounded-lg bg-ink-950 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-ink-900"
            >
              How we test
            </a>
            <a
              href="/editorial-policy/"
              class="rounded-lg border border-ink-300 px-4 py-2.5 text-sm font-semibold text-ink-700 transition hover:bg-ink-50"
            >
              Editorial policy
            </a>
          </div>
        </div>

        <ul class="grid gap-4 sm:grid-cols-2">
          {
            [
              {
                title: 'Tested, not summarised',
                body: 'Every review is based on hands-on use of a paid or trial plan, with hours logged on the page.',
              },
              {
                title: 'Named, credentialed authors',
                body: 'Each guide carries a real byline with verifiable experience and a public profile.',
              },
              {
                title: 'Fact-checked before publishing',
                body: 'An editor independently verifies pricing, claims and screenshots on comparison content.',
              },
              {
                title: 'Disclosed everywhere',
                body: 'Affiliate relationships are declared on every page that contains a tracked link.',
              },
            ].map((item) => (
              <li class="rounded-xl border border-ink-200 bg-ink-50/50 p-4">
                <h3 class="text-sm font-bold text-ink-950">{item.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-ink-600">{item.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
