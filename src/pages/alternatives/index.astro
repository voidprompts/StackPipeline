---
/**
 * Alternatives hub.
 */
import ListingLayout from '@layouts/ListingLayout.astro';
import ContentCard from '@components/ui/ContentCard.astro';
import { getCollection } from 'astro:content';
import { itemListSchema } from '@lib/schema';
import { absoluteUrl, readingTime as estimateReadingTime } from '@lib/seo';

const entries = await getCollection('alternatives', ({ data }) => !data.draft);

const enriched = entries.map((entry) => ({ entry }));

const sorted = enriched.sort(
  (a, b) =>
    (b.entry.data.updatedDate ?? b.entry.data.publishDate).getTime() -
    (a.entry.data.updatedDate ?? a.entry.data.publishDate).getTime(),
);

const schema = [
  itemListSchema(
    sorted.map((item, index) => ({
      position: index + 1,
      name: item.entry.data.heading ?? item.entry.data.title,
      description: item.entry.data.description,
      url: `/alternatives/${item.entry.id}/`,
    })),
    absoluteUrl('/alternatives/'),
    'Software alternatives and comparisons',
  ),
];
---

<ListingLayout
  title="Alternatives & Comparisons"
  heading="Software alternatives and comparisons"
  description="Ranked breakdowns of competing B2B tools, with assumptions and limitations readers can assess."
  count={entries.length}
  countLabel="comparisons"
  schema={schema}
  breadcrumbLeaf="Alternatives"
  intro="Comparisons should use consistent workflows and volume assumptions, then state the source, date and limitations behind each conclusion."
>
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      sorted.map((item) => (
        <ContentCard
          href={`/alternatives/${item.entry.id}/`}
          title={item.entry.data.heading ?? item.entry.data.title}
          description={item.entry.data.description}
          eyebrow="Comparison"
          date={item.entry.data.publishDate}
          updatedDate={item.entry.data.updatedDate}
          tags={item.entry.data.tags}
          authorName="StackPipeline Editorial Team"
          featured={item.entry.data.featured}
          readingTime={item.entry.data.readingTime ?? estimateReadingTime(item.entry.body ?? '')}
          headingLevel="h3"
        />
      ))
    }
  </div>

  {
    entries.length === 0 && (
      <p class="rounded-xl border border-dashed border-ink-300 bg-ink-50 p-8 text-center text-ink-500">
        No comparisons published yet.
      </p>
    )
  }
</ListingLayout>
