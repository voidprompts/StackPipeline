---
/**
 * Global navigation.
 *
 * Progressive enhancement only: the mobile menu is a <details> element, so navigation
 * works with JavaScript disabled and costs zero JS bytes.
 */
import { SITE, PRIMARY_NAV } from '@config/site';

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href.replace(/\/$/, ''));
}
---

<header class="sticky top-0 z-50 border-b border-ink-200/70 bg-white/85 backdrop-blur-md">
  <div class="sp-shell">
    <nav class="flex h-16 items-center justify-between gap-4" aria-label="Primary">
      <a href="/" class="group flex shrink-0 items-center gap-2.5" aria-label={`${SITE.name} home`}>
        <span
          class="grid h-9 w-9 place-items-center rounded-lg bg-ink-950 shadow-card transition group-hover:bg-ink-900"
          aria-hidden="true"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-emerald-400"
          >
            <path d="M4 7h7a4 4 0 0 1 4 4v2a4 4 0 0 0 4 4h1" />
            <circle cx="4" cy="7" r="1.6" fill="currentColor" />
            <circle cx="20" cy="17" r="1.6" fill="currentColor" />
            <path d="M4 17h4" />
          </svg>
        </span>
        <span class="text-[17px] font-bold tracking-tight text-ink-950">
          Stack<span class="text-emerald-600">Pipeline</span>
        </span>
      </a>

      {/* Desktop navigation */}
      <ul class="hidden items-center gap-1 lg:flex">
        {
          PRIMARY_NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
                  isActive(item.href)
                    ? 'bg-ink-100 text-ink-950'
                    : 'text-ink-600 hover:bg-ink-50 hover:text-ink-950',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="hidden items-center gap-3 lg:flex">
        <a
          href="/tools/"
          class="rounded-lg border border-ink-200 px-3.5 py-2 text-sm font-semibold text-ink-700 transition hover:border-ink-300 hover:bg-ink-50"
        >
          Tool directory
        </a>
        <a
          href="/integrations/"
          class="rounded-lg bg-emerald-600 px-3.5 py-2 text-sm font-semibold text-white shadow-emerald-glow transition hover:bg-emerald-700"
        >
          Browse integrations
        </a>
      </div>

      {/* Mobile menu — CSS-only disclosure widget */}
      <details class="group relative lg:hidden">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-ink-200 text-ink-700 transition hover:bg-ink-50 [&::-webkit-details-marker]:hidden"
          aria-label="Toggle navigation menu"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            class="group-open:hidden"
            aria-hidden="true"
          >
            <path d="M3 6h18M3 12h18M3 18h18" />
          </svg>
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            class="hidden group-open:block"
            aria-hidden="true"
          >
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </summary>

        <div
          class="absolute right-0 top-12 w-72 origin-top-right animate-fade-up rounded-xl border border-ink-200 bg-white p-2 shadow-lift"
        >
          <ul class="flex flex-col">
            {
              PRIMARY_NAV.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                    class:list={[
                      'block rounded-lg px-3 py-2.5 transition',
                      isActive(item.href) ? 'bg-ink-100' : 'hover:bg-ink-50',
                    ]}
                  >
                    <span class="block text-sm font-semibold text-ink-950">{item.label}</span>
                    {item.description && (
                      <span class="mt-0.5 block text-xs text-ink-500">{item.description}</span>
                    )}
                  </a>
                </li>
              ))
            }
          </ul>
          <a
            href="/integrations/"
            class="mt-2 block rounded-lg bg-emerald-600 px-3 py-2.5 text-center text-sm font-semibold text-white"
          >
            Browse integrations
          </a>
        </div>
      </details>
    </nav>
  </div>
</header>
