---
/**
 * Author bio block — the primary on-page E-E-A-T signal.
 *
 * Google's quality raters look for a named, credentialed human with a linkable profile.
 * This renders the byline, credentials, areas of expertise and sameAs links, and mirrors
 * the Person JSON-LD emitted by the page layout.
 */
import type { CollectionEntry } from 'astro:content';
import { SITE } from '@config/site';

interface Props {
  author: CollectionEntry<'authors'>;
  /** Compact inline variant for card footers. */
  variant?: 'full' | 'compact';
  /** Heading level so the document outline never skips a level. */
  headingLevel?: 'h2' | 'h3';
  class?: string;
}

const { author, variant = 'full', headingLevel = 'h2', class: className = '' } = Astro.props;
const data = author.data;
const profileUrl = `/authors/${data.slug}/`;
const Heading = headingLevel;

const initials = data.name
  .split(' ')
  .map((part) => part[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();

const socialLinks = Object.entries(data.links).filter(([, url]) => Boolean(url)) as Array<
  [string, string]
>;

const SOCIAL_LABELS: Record<string, string> = {
  linkedin: 'LinkedIn',
  x: 'X',
  github: 'GitHub',
  website: 'Website',
};
---

{
  variant === 'compact' ? (
    <div class={`not-prose flex items-center gap-2.5 ${className}`}>
      <span
        class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-ink-950 text-[11px] font-bold text-emerald-400"
        aria-hidden="true"
      >
        {initials}
      </span>
      <span class="text-sm">
        <a href={profileUrl} class="font-semibold text-ink-900 hover:text-emerald-700">
          {data.name}
        </a>
        <span class="block text-xs text-ink-500">{data.role}</span>
      </span>
    </div>
  ) : (
    <aside
      class={`not-prose rounded-2xl border border-ink-200 bg-ink-50/50 p-5 sm:p-6 ${className}`}
      aria-labelledby={`author-${data.slug}`}
    >
      <div class="flex flex-col gap-5 sm:flex-row">
        <span
          class="grid h-16 w-16 shrink-0 place-items-center rounded-full bg-ink-950 text-xl font-bold text-emerald-400 shadow-card"
          aria-hidden="true"
        >
          {initials}
        </span>

        <div class="min-w-0 flex-1">
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-emerald-700">
            Written by
          </p>
          <Heading id={`author-${data.slug}`} class="mt-1 text-lg font-bold text-ink-950">
            <a href={profileUrl} class="hover:text-emerald-700">
              {data.name}
            </a>
          </Heading>
          <p class="text-sm font-medium text-ink-600">
            {data.role}
            {data.yearsExperience && (
              <span class="text-ink-400"> · {data.yearsExperience}+ years in the field</span>
            )}
          </p>

          <p class="mt-3 text-sm leading-relaxed text-ink-700">{data.bio}</p>

          {data.credentials.length > 0 && (
            <ul class="mt-3.5 flex flex-wrap gap-1.5">
              {data.credentials.map((credential) => (
                <li class="sp-chip">
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="text-emerald-600"
                    aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  {credential}
                </li>
              ))}
            </ul>
          )}

          {data.expertise.length > 0 && (
            <p class="mt-3 text-xs text-ink-500">
              <span class="font-semibold text-ink-600">Expertise:</span>{' '}
              {data.expertise.join(' · ')}
            </p>
          )}

          <div class="mt-4 flex flex-wrap items-center gap-3">
            <a
              href={profileUrl}
              class="text-sm font-semibold text-emerald-700 underline decoration-emerald-300 underline-offset-4 hover:decoration-emerald-600"
            >
              All articles by {data.name.split(' ')[0]}
            </a>
            {socialLinks.map(([key, url]) => (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer me"
                class="text-sm text-ink-500 transition hover:text-ink-900"
              >
                {SOCIAL_LABELS[key] ?? key}
              </a>
            ))}
            {data.email && (
              <a
                href={`mailto:${data.email}`}
                class="text-sm text-ink-500 transition hover:text-ink-900"
              >
                Email
              </a>
            )}
          </div>
        </div>
      </div>

      <p class="mt-5 border-t border-ink-200 pt-4 text-xs leading-relaxed text-ink-500">
        {SITE.name} authors test every tool they write about on a paid or trial plan before
        publishing. See our{' '}
        <a href="/how-we-test/" class="font-medium text-emerald-700 underline">
          testing methodology
        </a>{' '}
        and{' '}
        <a href="/editorial-policy/" class="font-medium text-emerald-700 underline">
          editorial policy
        </a>
        .
      </p>
    </aside>
  )
}
