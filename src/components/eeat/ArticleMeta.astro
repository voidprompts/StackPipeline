---
/**
 * Byline + freshness strip.
 *
 * Surfaces the four trust signals Google's Helpful Content guidance asks for:
 * who wrote it, who fact-checked it, when it was published, and when it was last verified.
 * `<time datetime>` is machine-readable and mirrors the JSON-LD dates exactly.
 */
import type { CollectionEntry } from 'astro:content';
import { formatDate, isoDate, relativeTime, humanizeDuration } from '@lib/seo';

interface Props {
  author: CollectionEntry<'authors'>;
  reviewer?: CollectionEntry<'authors'>;
  publishDate: Date;
  updatedDate?: Date;
  lastReviewedDate?: Date;
  readingTime?: number;
  /** ISO-8601 duration, e.g. "PT15M" — shown on HowTo pages. */
  totalTime?: string;
  difficulty?: string;
  class?: string;
}

const {
  author,
  reviewer,
  publishDate,
  updatedDate,
  lastReviewedDate,
  readingTime,
  totalTime,
  difficulty,
  class: className = '',
} = Astro.props;

const displayDate = updatedDate ?? publishDate;
const isUpdated = Boolean(updatedDate && updatedDate.getTime() > publishDate.getTime());
const initials = author.data.name
  .split(' ')
  .map((part) => part[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

<div class={`not-prose ${className}`}>
  <div class="flex flex-wrap items-center gap-x-5 gap-y-3 text-sm">
    {/* Byline */}
    <div class="flex items-center gap-2.5">
      <span
        class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-ink-950 text-xs font-bold text-emerald-400"
        aria-hidden="true"
      >
        {initials}
      </span>
      <span>
        <a
          href={`/authors/${author.data.slug}/`}
          rel="author"
          class="font-semibold text-ink-900 hover:text-emerald-700"
        >
          {author.data.name}
        </a>
        <span class="block text-xs text-ink-500">{author.data.role}</span>
      </span>
    </div>

    <span class="hidden h-8 w-px bg-ink-200 sm:block" aria-hidden="true"></span>

    {/* Dates */}
    <div class="text-ink-600">
      <p>
        {isUpdated ? 'Updated' : 'Published'}{' '}
        <time datetime={isoDate(displayDate)} class="font-medium text-ink-900">
          {formatDate(displayDate)}
        </time>
        <span class="text-ink-400"> · {relativeTime(displayDate)}</span>
      </p>
      {
        isUpdated && (
          <p class="text-xs text-ink-400">
            Originally published{' '}
            <time datetime={isoDate(publishDate)}>{formatDate(publishDate)}</time>
          </p>
        )
      }
    </div>
  </div>

  {/* Fact-check + effort badges */}
  <div class="mt-4 flex flex-wrap items-center gap-2">
    {
      reviewer && (
        <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-800">
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 12l2 2 4-4" />
            <path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0" />
          </svg>
          Fact-checked by{' '}
          <a href={`/authors/${reviewer.data.slug}/`} class="underline underline-offset-2">
            {reviewer.data.name}
          </a>
        </span>
      )
    }

    {
      lastReviewedDate && (
        <span class="sp-chip">
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M12 8v4l3 2" />
            <circle cx="12" cy="12" r="9" />
          </svg>
          Verified <time datetime={isoDate(lastReviewedDate)}>{formatDate(lastReviewedDate)}</time>
        </span>
      )
    }

    {readingTime && <span class="sp-chip">{readingTime} min read</span>}
    {totalTime && <span class="sp-chip">Setup: {humanizeDuration(totalTime)}</span>}
    {
      difficulty && (
        <span class="sp-chip capitalize">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true" />
          {difficulty}
        </span>
      )
    }
  </div>
</div>
