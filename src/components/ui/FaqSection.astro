---
/**
 * FAQ accordion.
 *
 * Native <details>/<summary>: zero JavaScript, keyboard accessible by default, and the
 * answer text is present in the DOM at load so crawlers index it (content hidden behind
 * JS toggles is discounted). Pairs with FAQPage JSON-LD.
 */
interface Props {
  items: Array<{ question: string; answer: string }>;
  title?: string;
  headingLevel?: 'h2' | 'h3';
  class?: string;
  id?: string;
}

const {
  items,
  title = 'Frequently asked questions',
  headingLevel = 'h2',
  class: className = '',
  id = 'faq',
} = Astro.props;

const Heading = headingLevel;
const ItemHeading = headingLevel === 'h2' ? 'h3' : 'h4';
---

{
  items.length > 0 && (
    <section class={`not-prose my-12 ${className}`} aria-labelledby={`${id}-heading`}>
      <Heading id={`${id}-heading`} class="text-2xl font-bold text-ink-950 sm:text-3xl">
        {title}
      </Heading>

      <div class="mt-6 divide-y divide-ink-200 overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-card">
        {items.map((item, index) => (
          <details class="group" open={index === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 transition hover:bg-ink-50 [&::-webkit-details-marker]:hidden">
              <ItemHeading class="text-[15px] font-semibold text-ink-900">
                {item.question}
              </ItemHeading>
              <span
                class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-ink-200 text-ink-500 transition group-open:rotate-180 group-open:border-emerald-300 group-open:bg-emerald-50 group-open:text-emerald-700"
                aria-hidden="true"
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </span>
            </summary>
            <div class="px-5 pb-5 text-[15px] leading-relaxed text-ink-600">{item.answer}</div>
          </details>
        ))}
      </div>
    </section>
  )
}
