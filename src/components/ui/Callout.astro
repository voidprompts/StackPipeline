---
/**
 * Accessible call-out banners.
 *
 * Variants map to the editorial vocabulary used across the site: Editor's Choice,
 * Pro Tip, Integration Shortcut, Warning, and a neutral Note. Each variant pairs an
 * icon with a text label — colour is never the only signal, which is a WCAG requirement.
 */
type Variant = 'choice' | 'tip' | 'shortcut' | 'warn' | 'note';

interface Props {
  variant?: Variant;
  /** Overrides the default variant title. */
  title?: string;
  class?: string;
}

const { variant = 'note', title, class: className = '' } = Astro.props;

const VARIANTS: Record<
  Variant,
  { label: string; wrapper: string; badge: string; icon: string; iconPath: string }
> = {
  choice: {
    label: "Editor's Choice",
    wrapper: 'border-violet-200 bg-violet-50/70',
    badge: 'bg-violet-600 text-white',
    icon: 'text-violet-600',
    iconPath:
      'M11.48 3.5a.56.56 0 0 1 1.04 0l2.13 4.32 4.77.7c.46.06.64.63.31.95l-3.45 3.36.81 4.75c.08.46-.4.81-.81.59L12 15.92l-4.27 2.25c-.41.22-.89-.13-.81-.59l.81-4.75-3.45-3.36a.56.56 0 0 1 .31-.95l4.77-.7z',
  },
  tip: {
    label: 'Pro Tip',
    wrapper: 'border-emerald-200 bg-emerald-50/70',
    badge: 'bg-emerald-600 text-white',
    icon: 'text-emerald-600',
    iconPath:
      'M12 2a7 7 0 0 0-4 12.74V17a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-2.26A7 7 0 0 0 12 2M9.5 21h5',
  },
  shortcut: {
    label: 'Integration Shortcut',
    wrapper: 'border-sky-200 bg-sky-50/70',
    badge: 'bg-sky-600 text-white',
    icon: 'text-sky-600',
    iconPath: 'M13 2 4.5 13.5H11l-1 8.5 8.5-11.5H12z',
  },
  warn: {
    label: 'Heads up',
    wrapper: 'border-amber-200 bg-amber-50/70',
    badge: 'bg-amber-500 text-ink-950',
    icon: 'text-amber-600',
    iconPath: 'M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0',
  },
  note: {
    label: 'Note',
    wrapper: 'border-ink-200 bg-ink-50/70',
    badge: 'bg-ink-800 text-white',
    icon: 'text-ink-600',
    iconPath: 'M12 16v-4m0-4h.01M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0',
  },
};

const config = VARIANTS[variant];
const heading = title ?? config.label;
---

<aside class={`not-prose my-7 rounded-xl border p-4 sm:p-5 ${config.wrapper} ${className}`}>
  <div class="flex items-start gap-3.5">
    <span
      class={`mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-white shadow-sm ${config.icon}`}
      aria-hidden="true"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d={config.iconPath}></path>
      </svg>
    </span>

    <div class="min-w-0 flex-1">
      <p class="flex flex-wrap items-center gap-2">
        <span
          class={`inline-flex items-center rounded-md px-2 py-0.5 text-[11px] font-bold uppercase tracking-wider ${config.badge}`}
        >
          {config.label}
        </span>
        {
          title && (
            <span class="text-sm font-semibold text-ink-950">{heading}</span>
          )
        }
      </p>
      <div
        class="mt-2 text-[0.95rem] leading-relaxed text-ink-700 [&>*:first-child]:mt-0 [&>*:last-child]:mb-0 [&_a]:font-medium [&_a]:text-emerald-700 [&_a]:underline [&_p]:my-2"
      >
        <slot />
      </div>
    </div>
  </div>
</aside>
