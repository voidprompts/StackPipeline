---
/**
 * Pros & cons panel.
 *
 * Mirrors the positiveNotes/negativeNotes arrays in Review schema, which is what makes a
 * page eligible for the pros-and-cons rich result in Google Search.
 */
interface Props {
  pros: string[];
  cons: string[];
  title?: string;
  headingLevel?: 'h2' | 'h3' | 'h4';
  class?: string;
}

const { pros, cons, title, headingLevel = 'h3', class: className = '' } = Astro.props;
const Heading = headingLevel;
const SubHeading = headingLevel === 'h2' ? 'h3' : 'h4';
---

<section class={`not-prose my-8 ${className}`} aria-label={title ?? 'Pros and cons'}>
  {title && <Heading class="mb-4 text-xl font-bold text-ink-950">{title}</Heading>}

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="rounded-xl border border-emerald-200 bg-emerald-50/50 p-5">
      <SubHeading class="flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-emerald-800">
        <span class="grid h-6 w-6 place-items-center rounded-md bg-emerald-600 text-white" aria-hidden="true">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
        </span>
        What we liked
      </SubHeading>
      <ul class="mt-3.5 space-y-2.5">
        {
          pros.map((item) => (
            <li class="flex gap-2.5 text-sm leading-relaxed text-ink-700">
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="mt-1 shrink-0 text-emerald-600"
                aria-hidden="true"
              >
                <path d="M20 6 9 17l-5-5" />
              </svg>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="rounded-xl border border-ink-200 bg-ink-50/60 p-5">
      <SubHeading class="flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-ink-700">
        <span class="grid h-6 w-6 place-items-center rounded-md bg-ink-700 text-white" aria-hidden="true">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
          >
            <path d="M18 6 6 18M6 6l12 12"></path>
          </svg>
        </span>
        Where it falls short
      </SubHeading>
      <ul class="mt-3.5 space-y-2.5">
        {
          cons.map((item) => (
            <li class="flex gap-2.5 text-sm leading-relaxed text-ink-700">
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                class="mt-1 shrink-0 text-ink-400"
                aria-hidden="true"
              >
                <path d="M18 6 6 18M6 6l12 12" />
              </svg>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
