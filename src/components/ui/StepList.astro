---
/**
 * Numbered HowTo step list.
 *
 * Each step gets a stable `#step-N` id that matches the `url` field emitted in HowTo
 * JSON-LD, so Google can deep-link individual steps in the rich result.
 */
import { Code } from 'astro:components';

interface Step {
  name: string;
  text: string;
  code?: string;
  tip?: string;
  image?: string;
}

interface Props {
  steps: Step[];
  headingLevel?: 'h2' | 'h3';
  class?: string;
}

const { steps, headingLevel = 'h3', class: className = '' } = Astro.props;
const Heading = headingLevel;
---

<ol class={`not-prose my-8 space-y-5 ${className}`}>
  {
    steps.map((step, index) => (
      <li
        id={`step-${index + 1}`}
        class="relative scroll-mt-24 rounded-2xl border border-ink-200 bg-white p-5 shadow-card sm:p-6"
      >
        <div class="flex items-start gap-4">
          <span
            class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-emerald-600 text-sm font-bold text-white"
            aria-hidden="true"
          >
            {index + 1}
          </span>

          <div class="min-w-0 flex-1">
            <Heading class="text-lg font-bold leading-snug text-ink-950">
              <span class="sr-only">Step {index + 1}: </span>
              {step.name}
            </Heading>

            <p class="mt-2 text-[15px] leading-relaxed text-ink-700">{step.text}</p>

            {step.code && (
              <div class="mt-4 overflow-hidden rounded-xl border border-ink-800">
                <Code code={step.code} lang="json" theme="github-dark-default" wrap />
              </div>
            )}

            {step.tip && (
              <p class="mt-3.5 flex gap-2.5 rounded-lg border border-emerald-200 bg-emerald-50/70 p-3 text-sm text-emerald-900">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="mt-0.5 shrink-0 text-emerald-600"
                  aria-hidden="true"
                >
                  <path d="M12 2a7 7 0 0 0-4 12.74V17a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-2.26A7 7 0 0 0 12 2" />
                  <path d="M9.5 21h5" />
                </svg>
                <span>
                  <strong class="font-semibold">Tip:</strong> {step.tip}
                </span>
              </p>
            )}
          </div>
        </div>
      </li>
    ))
  }
</ol>
