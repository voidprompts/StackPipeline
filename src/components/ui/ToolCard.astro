---
/**
 * Directory card for a single SaaS tool.
 * Used on /tools/ and in "related tools" rails.
 */
import type { CollectionEntry } from 'astro:content';
import RatingStars from './RatingStars.astro';

interface Props {
  tool: CollectionEntry<'tools'>;
  href?: string;
  headingLevel?: 'h2' | 'h3';
  class?: string;
}

const { tool, href, headingLevel = 'h3', class: className = '' } = Astro.props;
const data = tool.data;
const Heading = headingLevel;
const target = href ?? `/tools/${data.slug}/`;
const initial = data.name.charAt(0).toUpperCase();
---

<article
  class={`group relative flex flex-col rounded-2xl border border-ink-200 bg-white p-5 shadow-card transition-all duration-200 hover:-translate-y-0.5 hover:border-ink-300 hover:shadow-lift ${className}`}
>
  <div class="flex items-start gap-3">
    <span
      class="grid h-10 w-10 shrink-0 place-items-center rounded-xl text-sm font-bold text-white"
      style={`background-color:${data.brandColor}`}
      aria-hidden="true"
    >
      {initial}
    </span>
    <div class="min-w-0 flex-1">
      <Heading class="text-base font-bold text-ink-950">
        <a href={target} class="before:absolute before:inset-0 before:content-[''] group-hover:text-emerald-700">
          {data.name}
        </a>
      </Heading>
      <p class="truncate text-xs text-ink-500">{data.category}</p>
    </div>
    {
      data.freeTier && (
        <span class="shrink-0 rounded-md border border-emerald-200 bg-emerald-50 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-emerald-700">
          Free tier
        </span>
      )
    }
  </div>

  <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-600">{data.tagline}</p>

  <dl class="mt-4 grid grid-cols-2 gap-3 border-t border-ink-100 pt-3.5 text-xs">
    <div>
      <dt class="text-ink-400">From</dt>
      <dd class="font-semibold text-ink-900">{data.startingPrice}</dd>
    </div>
    <div>
      <dt class="text-ink-400">Integrations</dt>
      <dd class="font-semibold text-ink-900">
        {data.nativeIntegrations > 0 ? `${data.nativeIntegrations.toLocaleString('en-US')}+` : '—'}
      </dd>
    </div>
  </dl>

  {
    data.rating && (
      <div class="mt-3">
        <RatingStars value={data.rating} size="sm" />
      </div>
    )
  }
</article>
